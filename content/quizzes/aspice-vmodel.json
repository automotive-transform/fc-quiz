    {
      "id": "aspice-v-model-quiz-001",
      "topicId": "aspice",
      "sectionId": "v-model",
      "questionType": "single_choice",
      "questionEn": "What does the V-Model represent in software development?",
      "options": [
        {
          "id": "A",
          "text": "Each design phase has a corresponding verification or testing phase."
        },
        {
          "id": "B",
          "text": "Software is developed without formal testing."
        },
        {
          "id": "C",
          "text": "All testing is performed before requirements are defined."
        },
        {
          "id": "D",
          "text": "Only hardware components are verified."
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "V-Model liên kết từng giai đoạn thiết kế ở bên trái với giai đoạn kiểm tra tương ứng ở bên phải.",
      "relatedFlashcardIds": [
        "aspice-v-model-concept-001"
      ],
      "source": {
        "type": "technical_document",
        "document": "Automotive Transform",
        "section": "V-Model",
        "reference": "content-source/Automotive Transform.md"
      },
      "reviewStatus": "draft"
    },
    {
      "id": "traceability-v-model-quiz-002",
      "topicId": "traceability",
      "sectionId": "v-model",
      "questionType": "single_choice",
      "questionEn": "What is the main principle of traceability in the V-Model?",
      "options": [
        {
          "id": "A",
          "text": "Every requirement and design decision should be linked to corresponding verification or testing."
        },
        {
          "id": "B",
          "text": "Only source code needs to be documented."
        },
        {
          "id": "C",
          "text": "Testing is optional when architecture is complete."
        },
        {
          "id": "D",
          "text": "Requirements are defined only after qualification testing."
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "Traceability giúp liên kết requirement và design decision với các hoạt động verification/test tương ứng.",
      "relatedFlashcardIds": [
        "traceability-v-model-concept-002"
      ],
      "source": {
        "type": "technical_document",
        "document": "Automotive Transform",
        "section": "V-Model",
        "reference": "content-source/Automotive Transform.md"
      },
      "reviewStatus": "draft"
    },
    {
      "id": "aspice-swe1-quiz-003",
      "topicId": "aspice",
      "sectionId": "swe-1",
      "questionType": "single_choice",
      "questionEn": "What is the primary purpose of SWE.1?",
      "options": [
        {
          "id": "A",
          "text": "To transform system-level requirements into testable software-level requirements."
        },
        {
          "id": "B",
          "text": "To test the complete software on target hardware."
        },
        {
          "id": "C",
          "text": "To combine software components and test their interfaces."
        },
        {
          "id": "D",
          "text": "To write only the final source code."
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "SWE.1 chuyển system requirements thành software requirements có thể kiểm tra được.",
      "relatedFlashcardIds": [
        "aspice-swe1-technical-term-003"
      ],
      "source": {
