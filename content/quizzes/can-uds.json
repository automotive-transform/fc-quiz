      "sectionId": "uds-overview",
      "questionType": "single_choice",
      "questionEn": "What does UDS stand for?",
      "options": [
        { "id": "A", "text": "Unified Diagnostic Services" },
        { "id": "B", "text": "Universal Data System" },
        { "id": "C", "text": "Unified Drive Software" },
