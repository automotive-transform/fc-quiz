    {
      "id": "can-overview-quiz-004",
      "topicId": "can",
      "sectionId": "network-motivation",
      "questionType": "single_choice",
      "questionEn": "What is a major problem with point-to-point wiring between many ECUs?",
      "options": [
        {
          "id": "A",
          "text": "It requires too many separate communication cables"
        },
        {
          "id": "B",
          "text": "It makes every ECU wireless"
        },
        {
          "id": "C",
          "text": "It eliminates all communication between ECUs"
        },
        {
          "id": "D",
          "text": "It reduces the number of ECUs automatically"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "Khi nhiều ECU cần trao đổi dữ liệu trực tiếp, số lượng dây tăng rất nhanh, làm hệ thống trở nên nặng, phức tạp và tốn chi phí.",
      "relatedFlashcardIds": [
        "can-overview-013",
        "can-overview-014"
      ],
      "source": {
        "type": "technical_document",
        "document": "CAN Overview",
        "section": "Network motivation",
        "reference": "content-source/CAN/CAN-overview.md"
      },
      "reviewStatus": "draft"
    },
    {
      "id": "can-overview-quiz-005",
      "topicId": "can",
      "sectionId": "network-motivation",
      "questionType": "single_choice",
      "questionEn": "In the example with 100 ECUs, each sharing data with an average of 20 other ECUs, how many point-to-point cables are required?",
      "options": [
        {
          "id": "A",
          "text": "100"
        },
        {
          "id": "B",
          "text": "500"
        },
        {
          "id": "C",
          "text": "1000"
        },
        {
          "id": "D",
          "text": "2000"
        }
      ],
      "correctOptionId": "C",
      "explanationVi": "Theo ví dụ nguồn: 100 × 20 / 2 = 1000 dây. Chia 2 vì mỗi kết nối giữa hai ECU được tính từ cả hai phía.",
      "relatedFlashcardIds": [
        "can-overview-014"
      ],
      "source": {
        "type": "technical_document",
        "document": "CAN Overview",
        "section": "Network motivation",
        "reference": "content-source/CAN/CAN-overview.md"
      },
      "reviewStatus": "draft"
    },
