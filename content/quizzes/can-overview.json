    {
      "id": "can-overview-quiz-009",
      "topicId": "can",
      "sectionId": "history",
      "questionType": "single_choice",
      "questionEn": "What major improvement did CAN-FD introduce compared with Classic CAN?",
      "options": [
        {
          "id": "A",
          "text": "Higher data-phase bandwidth and payload up to 64 bytes"
        },
        {
          "id": "B",
          "text": "Single-wire communication only"
        },
        {
          "id": "C",
          "text": "Removal of all ECUs from the vehicle"
        },
        {
          "id": "D",
          "text": "Replacement of CAN with LIN"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "Theo nguồn, CAN-FD tăng bandwidth từ 1 Mbps lên 8 Mbps và payload từ 8 lên 64 bytes.",
      "relatedFlashcardIds": [
        "can-overview-018"
      ],
      "source": {
