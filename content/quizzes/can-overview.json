    {
      "id": "can-overview-quiz-001",
      "topicId": "can",
      "sectionId": "ecu-network",
      "questionType": "single_choice",
      "questionEn": "Why is a modern vehicle often described as a mobile computer network?",
      "options": [
        {
          "id": "A",
          "text": "Because it contains many ECUs that communicate and exchange data"
        },
        {
          "id": "B",
          "text": "Because every vehicle uses only one central CPU"
        },
        {
          "id": "C",
          "text": "Because all vehicle functions are controlled mechanically"
        },
        {
          "id": "D",
          "text": "Because the vehicle does not need communication networks"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "Xe hiện đại có hàng chục đến hơn 100 ECU, mỗi ECU có CPU, memory và software, đồng thời trao đổi dữ liệu qua mạng xe.",
      "relatedFlashcardIds": [
        "can-overview-001",
        "can-overview-002"
      ],
      "source": {
        "type": "technical_document",
        "document": "CAN Overview",
        "section": "ECU network",
        "reference": "content-source/CAN/CAN-overview.md"
      },
      "reviewStatus": "draft"
    },
    {
      "id": "can-overview-quiz-002",
      "topicId": "can",
      "sectionId": "ecu-network",
      "questionType": "single_choice",
      "questionEn": "What is the main function of the ECM?",
      "options": [
        {
          "id": "A",
          "text": "Control engine functions such as fuel injection and ignition"
        },
        {
          "id": "B",
          "text": "Control only the vehicle windows"
        },
        {
          "id": "C",
          "text": "Manage GPS and cellular communication only"
        },
        {
          "id": "D",
          "text": "Control airbag deployment only"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "ECM (Engine Control Module) điều khiển động cơ, bao gồm phun nhiên liệu, đánh lửa và các chức năng liên quan đến emissions.",
      "relatedFlashcardIds": [
        "can-overview-003"
      ],
      "source": {
        "type": "technical_document",
        "document": "CAN Overview",
        "section": "ECU network",
        "reference": "content-source/CAN/CAN-overview.md"
      },
      "reviewStatus": "draft"
    },
