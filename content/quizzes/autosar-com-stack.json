      "id": "autosar-com-stack-quiz-003",
      "topicId": "autosar",
      "sectionId": "com-stack",
      "questionType": "single_choice",
      "questionEn": "What does CanDrv do after reading a frame from the mailbox?",
      "options": [
        {
          "id": "A",
          "text": "Calls CanIf_RxIndication() with the raw frame data"
        },
        {
          "id": "B",
          "text": "Extracts signals and applies scale and offset"
        },
        {
          "id": "C",
          "text": "Routes the signal directly to the SWC"
        },
        {
          "id": "D",
          "text": "Creates the RTE from ARXML"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "CanDrv đọc frame từ mailbox và gọi CanIf_RxIndication() với raw frame data.",
      "relatedFlashcardIds": [
        "autosar-com-stack-002"
      ],
      "source": {
