        {
          "id": "D",
          "text": "Receive the physical CAN frame in the RX mailbox"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "CanIf thực hiện mapping Controller ID → PDU ID, filter và gọi PduR_CanIfRxIndication().",
