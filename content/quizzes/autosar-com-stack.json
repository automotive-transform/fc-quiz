    {
      "id": "autosar-com-stack-quiz-001",
      "topicId": "autosar",
      "sectionId": "com-stack",
      "questionType": "single_choice",
      "questionEn": "What is the correct CAN receive flow from Hardware to SWC?",
      "options": [
        {
          "id": "A",
          "text": "CAN HW → CanDrv → CanIf → PduR → Com → RTE → SWC"
        },
        {
          "id": "B",
          "text": "CAN HW → Com → CanIf → CanDrv → RTE → PduR → SWC"
        },
        {
          "id": "C",
          "text": "CAN HW → PduR → CanDrv → Com → CanIf → RTE → SWC"
        },
        {
          "id": "D",
          "text": "CAN HW → RTE → Com → PduR → CanIf → CanDrv → SWC"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "Luồng chuẩn trong tài liệu là CAN HW → CanDrv → CanIf → PduR → Com → RTE → SWC.",
      "relatedFlashcardIds": [
        "autosar-com-stack-001",
        "autosar-com-stack-014"
      ],
      "source": {
        "type": "technical_document",
        "document": "COM Stack",
        "section": "CAN Signal Flow: Hardware to SWC",
        "reference": "content-source/AUTOSAR/COM-Stack.md"
      },
      "reviewStatus": "draft"
    },
    {
      "id": "autosar-com-stack-quiz-002",
      "topicId": "autosar",
      "sectionId": "com-stack",
      "questionType": "single_choice",
      "questionEn": "Where does the CAN Hardware place a received CAN frame?",
      "options": [
        {
          "id": "A",
          "text": "RX mailbox"
        },
        {
          "id": "B",
          "text": "RTE R-Port"
        },
        {
          "id": "C",
          "text": "Com signal buffer"
        },
        {
          "id": "D",
          "text": "PduR routing table"
        }
      ],
      "correctOptionId": "A",
      "explanationVi": "CAN Hardware nhận CAN frame và đưa frame vào RX mailbox để CanDrv đọc.",
