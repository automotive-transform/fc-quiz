    {
      "id": "safety-sotif-quiz-001",
      "topicId": "safety",
      "sectionId": "sotif",
      "questionType": "single_choice",
      "questionEn": "What does SOTIF stand for?",
      "options": [
        { "id": "A", "text": "Safety Of The Intended Functionality" },
        { "id": "B", "text": "System Of Technical Interface Failure" },
        { "id": "C", "text": "Safety Of The Integrated Fault" },
        { "id": "D", "text": "Software Operation Testing In Functionality" }
      ],
      "correctOptionId": "A",
      "explanationVi": "SOTIF = Safety Of The Intended Functionality, tập trung vào chức năng đúng nhưng có thể chưa đủ an toàn.",
      "relatedFlashcardIds": ["safety-sotif-001"],
      "source": {
        "type": "technical_document",
        "document": "SOTIF — ISO 21448",
        "section": "SOTIF",
        "reference": "content-source/Safety/SOTIF.md"
      },
