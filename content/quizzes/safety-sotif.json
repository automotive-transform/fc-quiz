    },
    {
      "id": "safety-sotif-quiz-002",
      "topicId": "safety",
      "sectionId": "sotif",
      "questionType": "single_choice",
      "questionEn": "What is the main focus of SOTIF?",
      "options": [
        { "id": "A", "text": "Hardware manufacturing defects only" },
        { "id": "B", "text": "Correct functionality that is not sufficiently safe" },
        { "id": "C", "text": "Only random hardware failures" },
        { "id": "D", "text": "Increasing software execution speed" }
      ],
      "correctOptionId": "B",
      "explanationVi": "SOTIF xét trường hợp thiết kế/chức năng đúng nhưng hành vi vẫn không đủ an toàn trong các scenario phức tạp.",
      "relatedFlashcardIds": ["safety-sotif-002"],
