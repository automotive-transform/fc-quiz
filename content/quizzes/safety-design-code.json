        { "id": "A", "text": "The EPS enters SAFE state" },
        { "id": "B", "text": "The EPS returns to INIT" },
        { "id": "C", "text": "The torque limit becomes 100%" },
        { "id": "D", "text": "The error counter is ignored" }
      ],
      "correctOptionId": "A",
      "explanationVi": "Khi gs_ErrorCount đạt 3 lỗi, EPS chuyển sang SAFE, disable motor, báo DEM FAILED và gửi EPS fault.",
