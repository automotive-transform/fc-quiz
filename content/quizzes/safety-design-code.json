      "id": "safety-design-code-quiz-002",
      "topicId": "safety",
      "sectionId": "safety-design-code",
      "questionType": "single_choice",
      "questionEn": "What does the Range Check pattern check first?",
      "options": [
        { "id": "A", "text": "Physical hard limits" },
        { "id": "B", "text": "Diagnostic DTC" },
        { "id": "C", "text": "Watchdog exit checkpoint" },
        { "id": "D", "text": "Motor torque limit" }
      ],
      "correctOptionId": "A",
      "explanationVi": "Range Check kiểm tra giới hạn vật lý (hard limit) trước, sau đó mới kiểm tra plausibility.",
