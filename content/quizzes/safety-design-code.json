      "topicId": "safety",
      "sectionId": "safety-design-code",
      "questionType": "single_choice",
      "questionEn": "What is the purpose of Safety Design Code?",
      "options": [
        { "id": "A", "text": "Implement safety mechanisms in C code" },
        { "id": "B", "text": "Replace the Safety Goal" },
        { "id": "C", "text": "Remove the need for ASIL" },
        { "id": "D", "text": "Only configure CAN messages" }
      ],
      "correctOptionId": "A",
      "explanationVi": "Sau khi có Safety Goal và ASIL, Safety Mechanisms được implement vào C code.",
